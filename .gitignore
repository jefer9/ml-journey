# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Datos: nunca subir datos reales del negocio.
# Ojo: si se excluye el directorio entero ("datos/"), git ni siquiera mira
# adentro y la excepción de abajo no se aplica nunca. Por eso "datos/*".
datos/*
*.csv
*.parquet
*.db
# ...salvo los de ejemplo, anonimizados, que sirven para reproducir
!datos/README.md
!datos/ejemplo/
!datos/ejemplo/*.csv

# Modelos
*.pt
*.pth
*.pkl
*.joblib
*.safetensors

# Secretos
.env
*.key

# Obsidian
.obsidian/workspace.json
.obsidian/cache/

# SO
.DS_Store
